# 이 파일을 frontend/.env.local 로 복사한 뒤 값을 채운다. (.env.local 은 커밋되지 않음)

# TossPayments 테스트 클라이언트 키 (결제 위젯)
VITE_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx

# Kakao Developers > 앱 > JavaScript 키 (지도, 카카오톡 공유)
# 플랫폼 > Web 에 http://localhost:5173 도메인을 등록해야 동작한다.
VITE_KAKAO_JS_KEY=your-kakao-javascript-key

# 백엔드 주소 (일부 페이지에서 사용, 기본값 http://localhost:8080)
VITE_API_URL=http://localhost:8080
