# 이 파일을 같은 폴더에 application-local.properties 로 복사한 뒤 값을 채운다.
# application-local.properties 는 .gitignore 대상이므로 절대 커밋되지 않는다.
# 같은 이름의 환경변수(DB_PASSWORD 등)를 설정해도 된다.

# MySQL (필수)
DB_URL=jdbc:mysql://localhost:3306/neoship?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your-local-db-password

# Gmail SMTP - 이메일 인증/알림 (선택, 비우면 메일 발송 기능만 실패)
GMAIL_USERNAME=your-account@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# TossPayments - 반드시 테스트 키(test_ck_ / test_sk_) 사용 (선택)
TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth2 로그인 (선택)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 최초 관리자 계정으로 승격할 회원 이메일 (선택)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# Redis / Ollama - 기본값이 있으므로 다를 때만 지정
# REDIS_HOST=localhost
# REDIS_PORT=6379
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:3b
